# ─── Meta (Facebook) Ad Library ───────────────────────────────────────────────
META_ACCESS_TOKEN=tu_token_aqui
META_API_VERSION=v21.0

# ─── Dropi.co ──────────────────────────────────────────────────────────────────
# Genera tu token en: Dropi → Menu → Integraciones → Copiar Token
DROPI_INTEGRATION_KEY=tu_integration_key_aqui

# Opcional: si tu cuenta usa una URL base diferente (ej: sandbox)
# DROPI_BASE_URL=https://app.dropi.co

# ─── Shopify ───────────────────────────────────────────────────────────────────
# Dominio de tu tienda (sin https://)
SHOPIFY_STORE_DOMAIN=mi-tienda.myshopify.com

# Token de acceso de tu app privada/custom app
# Shopify Admin → Settings → Apps and sales channels → Develop apps
# Permisos necesarios: write_products, write_content
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# Version de la API (no cambiar salvo que Shopify lo requiera)
SHOPIFY_API_VERSION=2024-01
