{% if template == 'index' %}
<div class="premium-hero-block">

  <!-- 1. BARRA DE URGENCIA (Fina, agresiva, arriba del todo) -->
  <div class="urgency-strip">
    <div class="urgency-track">
      <span class="timer-text" id="master-timer">00:09:39:54</span>
      <span class="alert-text">¡NUESTRA MAYOR REBAJA DE LA HISTORIA TERMINA PRONTO!</span>
    </div>
  </div>

  <!-- 2. ZONA DE VÍDEO CON ANIMACIONES -->
  <div class="video-zone">
    <!-- Filtro oscuro para que el texto resalte siempre -->
    <div class="dark-gradient-overlay"></div>

    <!-- TU VÍDEO (Asegúrate de pegar tu enlace .mp4 aquí) -->
    <video autoplay loop muted playsinline class="bg-video-full">
      <source src="https://tu-enlace-al-video.mp4" type="video/mp4">
    </video>

    <!-- TEXTOS CON ANIMACIÓN EN CASCADA -->
    <div class="animated-content">
      <p class="hero-subtitle fade-up delay-1">HASTA UN 70% DE DESCUENTO</p>
      <h1 class="hero-title fade-up delay-2">REBAJAS DE<br>PRIMAVERA '26</h1>
      <div class="fade-up delay-3">
        <a href="/collections/all" class="hero-btn-action">VER COLECCIÓN</a>
      </div>
    </div>
  </div>

</div>

<style>
  /* --- BASE --- */
  .premium-hero-block {
    width: 100%;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: #000;
  }

  /* --- BARRA DE URGENCIA --- */
  .urgency-strip {
    background: #000;
    color: #fff;
    text-align: center;
    padding: 10px 5px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .urgency-track {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  .alert-text { color: #ff0000; text-transform: uppercase; }

  /* --- ZONA VÍDEO --- */
  .video-zone {
    position: relative;
    width: 100%;
    /* Ocupa el 85% de la pantalla para que se vea un poco de lo de abajo e invite a hacer scroll */
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .bg-video-full {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  /* Degradado sutil de negro a transparente */
  .dark-gradient-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0) 100%);
    z-index: 2;
  }

  /* --- TEXTOS Y ANIMACIÓN --- */
  .animated-content {
    position: absolute;
    bottom: 8%;
    left: 5%;
    z-index: 3;
    color: #fff;
    width: 90%;
    max-width: 600px;
  }

  .hero-subtitle {
    font-size: 13px;
    letter-spacing: 2px;
    margin: 0 0 10px 0;
    color: rgba(255,255,255,0.9);
    font-weight: bold;
  }
  .hero-title {
    font-size: clamp(35px, 8vw, 75px);
    line-height: 1.05;
    margin: 0 0 30px 0;
    font-weight: 400;
    text-transform: uppercase;
  }

  .hero-btn-action {
    display: inline-block;
    background: #fff;
    color: #000;
    text-decoration: none;
    padding: 18px 45px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: 0.3s;
  }
  .hero-btn-action:hover { background: #000; color: #fff; }

  /* LA ANIMACION */
  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUpAnim 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  /* Retrasos para que entren uno detrás de otro */
  .delay-1 { animation-delay: 0.2s; }
  .delay-2 { animation-delay: 0.4s; }
  .delay-3 { animation-delay: 0.6s; }

  @keyframes fadeInUpAnim {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- OPTIMIZACIÓN MÓVIL --- */
  @media (max-width: 768px) {
    .urgency-strip { font-size: 10px; padding: 8px 5px; }

    .video-zone { height: 80vh; }

    .animated-content { left: 0; padding: 0 20px; text-align: center; bottom: 8%; }
    .hero-title { font-size: 42px; margin: 0 0 25px 0; }
    .hero-subtitle { font-size: 11px; }

    .hero-btn-action { width: 100%; padding: 18px 0; font-size: 14px; }
  }
</style>

<script>
  // Contador Evergreen: Se reinicia automáticamente
  document.addEventListener("DOMContentLoaded", function() {
    let secs = (9 * 3600) + (39 * 60) + 54;
    const t = document.getElementById('master-timer');
    if(!t) return;
    setInterval(() => {
      if (secs <= 0) secs = 34794;
      let d = Math.floor(secs / 86400), h = Math.floor((secs % 86400) / 3600), m = Math.floor((secs % 3600) / 60), s = secs % 60;
      t.textContent = `${d.toString().padStart(2,'0')}:${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
      secs--;
    }, 1000);
  });
</script>
{% endif %}
