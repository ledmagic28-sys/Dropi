{% if template == 'index' %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300;400;600&display=swap" rel="stylesheet">

<div class="phv-wrap">

  <!-- BARRA URGENCIA + CONTADOR -->
  <div class="phv-strip">
    <div class="phv-strip-inner">
      <span class="phv-timer" id="master-timer">00:09:39:54</span>
      <span class="phv-strip-msg">¡NUESTRA MAYOR REBAJA DE LA HISTORIA TERMINA PRONTO!</span>
    </div>
  </div>

  <!-- HERO CON VÍDEO -->
  <div class="phv-hero">

    <!-- Vídeo de fondo — cambia el src por tu .mp4 -->
    <video autoplay loop muted playsinline class="phv-video">
      <source src="https://tu-enlace-al-video.mp4" type="video/mp4">
    </video>

    <!-- Degradado solo en la parte inferior para que el texto se lea -->
    <div class="phv-gradient"></div>

    <!-- Contenido animado -->
    <div class="phv-content">
      <h1 class="phv-title phv-fade delay-1">
        REBAJAS DE<br>PRIMAVERA '26
      </h1>
      <p class="phv-sub phv-fade delay-2">
        HASTA UN 70 % DE DESCUENTO EN LAS MEJORES PRENDAS
      </p>
      <div class="phv-fade delay-3">
        <a href="/collections/all" class="phv-btn">VER COLECCIÓN</a>
      </div>
    </div>

  </div>

</div>

<style>
  /* ── Fuente ──────────────────────────────────────────────── */
  .phv-wrap,
  .phv-wrap * {
    font-family: 'Raleway', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    box-sizing: border-box;
  }

  /* ── Barra de urgencia ───────────────────────────────────── */
  .phv-strip {
    width: 100%;
    background: #000;
    color: #fff;
    padding: 9px 12px;
    text-align: center;
  }
  .phv-strip-inner {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .phv-timer {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    min-width: 88px;
    display: inline-block;
  }
  .phv-strip-msg {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff2020;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .phv-hero {
    position: relative;
    width: 100%;
    height: 85vh;
    min-height: 520px;
    overflow: hidden;
    background: #e8e6e3; /* color base mientras carga el vídeo */
  }

  /* ── Vídeo ───────────────────────────────────────────────── */
  .phv-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* ── Degradado: solo abajo, como en la foto ──────────────── */
  .phv-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.52) 0%,
      rgba(0, 0, 0, 0.18) 35%,
      rgba(0, 0, 0, 0.00) 65%
    );
    z-index: 1;
  }

  /* ── Contenido de texto ──────────────────────────────────── */
  .phv-content {
    position: absolute;
    bottom: 7%;
    left: 4%;
    z-index: 2;
    color: #fff;
    max-width: 680px;
    width: 92%;
  }

  /* Título — ultra fino igual que en la foto */
  .phv-title {
    font-size: clamp(38px, 7.5vw, 82px);
    font-weight: 200;
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 14px 0;
    color: #fff;
  }

  /* Subtítulo — muy pequeño, espaciado, como en la foto */
  .phv-sub {
    font-size: clamp(9px, 1.1vw, 11px);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 28px 0;
    color: rgba(255, 255, 255, 0.92);
  }

  /* Botón — borde fino blanco, sin relleno, como en la foto */
  .phv-btn {
    display: inline-block;
    border: 1px solid rgba(255, 255, 255, 0.85);
    color: #fff;
    background: transparent;
    text-decoration: none;
    padding: 11px 24px;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .phv-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  /* ── Animación de entrada ────────────────────────────────── */
  .phv-fade {
    opacity: 0;
    transform: translateY(22px);
    animation: phvFadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  .delay-1 { animation-delay: 0.15s; }
  .delay-2 { animation-delay: 0.35s; }
  .delay-3 { animation-delay: 0.55s; }

  @keyframes phvFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Móvil ───────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .phv-hero { height: 80vh; min-height: 460px; }
    .phv-content { left: 0; padding: 0 18px; bottom: 8%; }
    .phv-title { font-size: 40px; margin-bottom: 12px; }
    .phv-sub { font-size: 9px; letter-spacing: 0.16em; }
    .phv-btn { width: 100%; text-align: center; padding: 14px 0; font-size: 10px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var secs = (9 * 3600) + (39 * 60) + 54;
    var el   = document.getElementById('master-timer');
    if (!el) return;
    function tick() {
      if (secs <= 0) secs = 34794;
      var d = Math.floor(secs / 86400);
      var h = Math.floor((secs % 86400) / 3600);
      var m = Math.floor((secs % 3600) / 60);
      var s = secs % 60;
      el.textContent =
        pad(d) + ':' + pad(h) + ':' + pad(m) + ':' + pad(s);
      secs--;
    }
    function pad(n) { return String(n).padStart(2, '0'); }
    tick();
    setInterval(tick, 1000);
  });
</script>

{% endif %}
