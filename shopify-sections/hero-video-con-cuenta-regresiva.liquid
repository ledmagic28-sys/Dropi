{%- liquid
  assign sid = section.id
  assign s   = section.settings
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300;400;600&display=swap" rel="stylesheet">

{% if s.mostrar_barra_contador %}
<div class="hv2-strip" id="hv2-strip-{{ sid }}"
  style="background:{{ s.color_barra_fondo }};color:{{ s.color_barra_texto }};">
  <div class="hv2-strip-inner">
    <span class="hv2-timer" id="hv2-timer-{{ sid }}">00:00:00:00</span>
    <span class="hv2-strip-msg" style="color:{{ s.color_alerta }};">
      {{ s.texto_barra }}
    </span>
  </div>
</div>
{% endif %}

<div class="hv2-hero{% if s.pantalla_completa %} hv2-full{% endif %}"
  id="hv2-hero-{{ sid }}"
  style="min-height:{{ s.altura_minima }}px;">

  <!-- Fondo: video o imagen -->
  <div class="hv2-media">
    {%- if s.video_url != blank -%}
      <video class="hv2-video" autoplay muted loop playsinline preload="auto">
        <source src="{{ s.video_url }}" type="video/mp4">
      </video>
    {%- elsif s.imagen_fallback != blank -%}
      <img class="hv2-video"
        src="{{ s.imagen_fallback | img_url: 'master' }}"
        alt="{{ s.titulo | escape }}"
        loading="lazy">
    {%- else -%}
      <div class="hv2-placeholder"></div>
    {%- endif -%}
  </div>

  <!-- Degradado suave solo abajo -->
  <div class="hv2-gradient"
    style="--hv2-grad-color:{{ s.color_overlay }};--hv2-grad-op:{{ s.opacidad_overlay | divided_by: 100.0 }};"></div>

  <!-- Contenido -->
  <div class="hv2-content">

    {%- if s.etiqueta != blank -%}
      <p class="hv2-label hv2-fade hv2-d1" style="color:{{ s.color_texto }};">
        {{ s.etiqueta }}
      </p>
    {%- endif -%}

    {%- if s.titulo != blank -%}
      <h1 class="hv2-title hv2-fade hv2-d2" style="color:{{ s.color_texto }};">
        {{ s.titulo }}
      </h1>
    {%- endif -%}

    {%- if s.subtitulo != blank -%}
      <p class="hv2-sub hv2-fade hv2-d3" style="color:{{ s.color_texto }};">
        {{ s.subtitulo }}
      </p>
    {%- endif -%}

    {%- if s.texto_boton != blank and s.url_boton != blank -%}
      <div class="hv2-fade hv2-d4">
        <a class="hv2-btn" href="{{ s.url_boton }}">
          {{ s.texto_boton }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* ── Fuente global de la sección ─────────────────────────── */
  #hv2-strip-{{ sid }},
  #hv2-hero-{{ sid }} {
    font-family: 'Raleway', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    box-sizing: border-box;
  }
  #hv2-hero-{{ sid }} * { box-sizing: border-box; }

  /* ── Barra urgencia ──────────────────────────────────────── */
  #hv2-strip-{{ sid }} {
    width: 100%;
    padding: 9px 14px;
    text-align: center;
    position: relative;
    z-index: 10;
  }
  #hv2-strip-{{ sid }} .hv2-strip-inner {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  #hv2-strip-{{ sid }} .hv2-timer {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: #ffffff;
    white-space: nowrap;
  }
  #hv2-strip-{{ sid }} .hv2-strip-msg {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  #hv2-hero-{{ sid }} {
    position: relative;
    width: 100%;
    height: 85vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #e8e6e3;
  }
  #hv2-hero-{{ sid }}.hv2-full { height: 100vh !important; }

  /* ── Media (video / imagen) ──────────────────────────────── */
  #hv2-hero-{{ sid }} .hv2-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #hv2-hero-{{ sid }} .hv2-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  #hv2-hero-{{ sid }} .hv2-placeholder {
    width: 100%;
    height: 100%;
    background: #1a1a1a;
  }

  /* ── Degradado solo abajo (como en la foto) ──────────────── */
  #hv2-hero-{{ sid }} .hv2-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--hv2-grad-color) calc(var(--hv2-grad-op) * 100%), transparent) 0%,
      color-mix(in srgb, var(--hv2-grad-color) calc(var(--hv2-grad-op) * 30%), transparent)  40%,
      transparent 70%
    );
  }

  /* ── Contenido ───────────────────────────────────────────── */
  #hv2-hero-{{ sid }} .hv2-content {
    position: relative;
    z-index: 2;
    padding: 0 4% 7%;
    width: 100%;
    max-width: 720px;
  }

  /* Etiqueta opcional arriba */
  #hv2-hero-{{ sid }} .hv2-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    opacity: 0.8;
  }

  /* Titulo — ultra fino igual que en la foto */
  #hv2-hero-{{ sid }} .hv2-title {
    font-size: clamp(38px, 7.5vw, 82px);
    font-weight: 200;
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 14px 0;
  }

  /* Subtitulo — muy pequeño, muy espaciado */
  #hv2-hero-{{ sid }} .hv2-sub {
    font-size: clamp(9px, 1vw, 11px);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 28px 0;
    opacity: 0.92;
  }

  /* Boton — blanco solido, negro al hover */
  #hv2-hero-{{ sid }} .hv2-btn {
    display: inline-block;
    background: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
    text-decoration: none;
    padding: 13px 30px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
    cursor: pointer;
  }
  #hv2-hero-{{ sid }} .hv2-btn:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  /* ── Animaciones fade-up en cascada ──────────────────────── */
  #hv2-hero-{{ sid }} .hv2-fade {
    opacity: 0;
    transform: translateY(24px);
    animation: hv2FadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  #hv2-hero-{{ sid }} .hv2-d1 { animation-delay: 0.1s; }
  #hv2-hero-{{ sid }} .hv2-d2 { animation-delay: 0.25s; }
  #hv2-hero-{{ sid }} .hv2-d3 { animation-delay: 0.45s; }
  #hv2-hero-{{ sid }} .hv2-d4 { animation-delay: 0.65s; }

  @keyframes hv2FadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Movil ───────────────────────────────────────────────── */
  @media (max-width: 768px) {
    #hv2-strip-{{ sid }} { font-size: 9px; padding: 8px 10px; }
    #hv2-hero-{{ sid }} { height: 80vh; min-height: 460px !important; }
    #hv2-hero-{{ sid }} .hv2-content { padding: 0 18px 10%; }
    #hv2-hero-{{ sid }} .hv2-title { font-size: 40px; }
    #hv2-hero-{{ sid }} .hv2-sub { font-size: 9px; letter-spacing: 0.14em; }
    #hv2-hero-{{ sid }} .hv2-btn { display: block; text-align: center; padding: 14px 0; }
  }
</style>

<script>
(function () {
  {% if s.mostrar_barra_contador %}
  var el     = document.getElementById('hv2-timer-{{ sid }}');
  var barraEl = document.getElementById('hv2-strip-{{ sid }}');
  if (!el) return;

  {% if s.modo_contador == 'evergreen' %}
  /* Modo evergreen: cuenta desde N segundos y se reinicia */
  var secs = {{ s.evergreen_horas }} * 3600 + {{ s.evergreen_minutos }} * 60;
  function pad(n) { return String(n).padStart(2,'0'); }
  function tick() {
    if (secs <= 0) secs = {{ s.evergreen_horas }} * 3600 + {{ s.evergreen_minutos }} * 60;
    var d = Math.floor(secs / 86400);
    var h = Math.floor((secs % 86400) / 3600);
    var m = Math.floor((secs % 3600) / 60);
    var sv = secs % 60;
    el.textContent = pad(d)+':'+pad(h)+':'+pad(m)+':'+pad(sv);
    secs--;
  }
  tick();
  setInterval(tick, 1000);

  {% else %}
  /* Modo fecha fija */
  var endTs = new Date('{{ s.fecha_fin_contador }}').getTime();
  function pad(n) { return String(n).padStart(2,'0'); }
  function tick() {
    var diff = endTs - Date.now();
    if (diff <= 0) {
      el.textContent = '00:00:00:00';
      {% if s.ocultar_barra_al_terminar %}
      if (barraEl) barraEl.style.display = 'none';
      {% endif %}
      return;
    }
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var sv = Math.floor((diff % 60000) / 1000);
    el.textContent = pad(d)+':'+pad(h)+':'+pad(m)+':'+pad(sv);
  }
  tick();
  setInterval(tick, 1000);
  {% endif %}

  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Hero Video Contador",
  "tag": "div",
  "class": "hv2-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Video y fondo"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL del video (.mp4)",
      "default": "https://example.com/video.mp4",
      "info": "Sube el video en Contenido > Archivos y pega la URL directa"
    },
    {
      "type": "image_picker",
      "id": "imagen_fallback",
      "label": "Imagen de respaldo"
    },
    {
      "type": "checkbox",
      "id": "pantalla_completa",
      "label": "Altura pantalla completa",
      "default": false
    },
    {
      "type": "range",
      "id": "altura_minima",
      "label": "Altura minima (px)",
      "min": 300,
      "max": 1000,
      "step": 10,
      "default": 620
    },
    {
      "type": "header",
      "content": "Overlay del video"
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "Color del degradado",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "opacidad_overlay",
      "label": "Intensidad del degradado (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 55
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "etiqueta",
      "label": "Etiqueta superior (opcional)",
      "default": "NUEVA COLECCION"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Titulo principal",
      "default": "REBAJAS DE PRIMAVERA"
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtitulo",
      "default": "HASTA UN 70% DE DESCUENTO EN LAS MEJORES PRENDAS"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Boton"
    },
    {
      "type": "text",
      "id": "texto_boton",
      "label": "Texto del boton",
      "default": "VER COLECCION"
    },
    {
      "type": "url",
      "id": "url_boton",
      "label": "Enlace del boton"
    },
    {
      "type": "color",
      "id": "color_boton_borde",
      "label": "Color del borde",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_boton_texto",
      "label": "Color del texto del boton",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_boton_fondo",
      "label": "Fondo del boton",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Barra y contador"
    },
    {
      "type": "checkbox",
      "id": "mostrar_barra_contador",
      "label": "Mostrar barra de urgencia",
      "default": true
    },
    {
      "type": "text",
      "id": "texto_barra",
      "label": "Texto de la barra",
      "default": "NUESTRA MAYOR REBAJA TERMINA PRONTO"
    },
    {
      "type": "color",
      "id": "color_alerta",
      "label": "Color del texto de alerta",
      "default": "#ff2020"
    },
    {
      "type": "color",
      "id": "color_barra_fondo",
      "label": "Fondo de la barra",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_barra_texto",
      "label": "Color del timer",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "modo_contador",
      "label": "Tipo de contador",
      "options": [
        { "value": "fecha", "label": "Fecha fija" },
        { "value": "evergreen", "label": "Evergreen (se reinicia solo)" }
      ],
      "default": "fecha"
    },
    {
      "type": "text",
      "id": "fecha_fin_contador",
      "label": "Fecha de fin (solo modo Fecha fija)",
      "default": "2026-06-01T23:59:59",
      "info": "Formato: AAAA-MM-DDTHH:MM:SS"
    },
    {
      "type": "range",
      "id": "evergreen_horas",
      "label": "Horas del contador Evergreen",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "evergreen_minutos",
      "label": "Minutos extra (Evergreen)",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "ocultar_barra_al_terminar",
      "label": "Ocultar barra al llegar a cero",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero Video Contador"
    }
  ]
}
{% endschema %}
