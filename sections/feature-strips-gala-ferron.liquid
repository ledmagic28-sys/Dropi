{% comment %}
  Section: Feature Strips — Gala Ferron
  Three trust-building feature blocks: Envío Gratis, Ayuda, Pago Seguro
{% endcomment %}

<section class="gf-features" id="gf-features-{{ section.id }}">
  <div class="gf-features__inner">

    {%- comment -%} ── ENVÍO GRATIS ── {%- endcomment -%}
    <div class="gf-feature">
      <div class="gf-feature__icon-wrap">
        <svg class="gf-feature__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <rect x="4" y="18" width="40" height="28" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"/>
          <path d="M44 26h8l8 10v10H44V26z" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linejoin="round"/>
          <circle cx="16" cy="50" r="5" stroke="currentColor" stroke-width="2.5" fill="none"/>
          <circle cx="50" cy="50" r="5" stroke="currentColor" stroke-width="2.5" fill="none"/>
          <line x1="4" y1="34" x2="44" y2="34" stroke="currentColor" stroke-width="2"/>
          <line x1="16" y1="18" x2="16" y2="34" stroke="currentColor" stroke-width="2"/>
          <line x1="28" y1="18" x2="28" y2="34" stroke="currentColor" stroke-width="2"/>
        </svg>
      </div>
      <h3 class="gf-feature__title">{{ section.settings.title_shipping }}</h3>
      <p class="gf-feature__desc">{{ section.settings.desc_shipping }}</p>
    </div>

    <div class="gf-features__divider" aria-hidden="true"></div>

    {%- comment -%} ── ¿NECESITAS AYUDA? ── {%- endcomment -%}
    <div class="gf-feature">
      <div class="gf-feature__icon-wrap">
        <svg class="gf-feature__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <path d="M8 12C8 9.79 9.79 8 12 8h40c2.21 0 4 1.79 4 4v28c0 2.21-1.79 4-4 4H20L8 56V12z" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linejoin="round"/>
          <circle cx="22" cy="26" r="2.5" fill="currentColor"/>
          <circle cx="32" cy="26" r="2.5" fill="currentColor"/>
          <circle cx="42" cy="26" r="2.5" fill="currentColor"/>
        </svg>
      </div>
      <h3 class="gf-feature__title">{{ section.settings.title_help }}</h3>
      <p class="gf-feature__desc">{{ section.settings.desc_help }}</p>
      <a class="gf-feature__link" href="mailto:{{ section.settings.email }}">
        {{- section.settings.email -}}
      </a>
    </div>

    <div class="gf-features__divider" aria-hidden="true"></div>

    {%- comment -%} ── PAGO SEGURO ── {%- endcomment -%}
    <div class="gf-feature">
      <div class="gf-feature__icon-wrap">
        <svg class="gf-feature__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <path d="M32 4L8 14v18c0 14 12 24 24 28 12-4 24-14 24-28V14L32 4z" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linejoin="round"/>
          <polyline points="20,32 28,40 46,22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="gf-feature__title">{{ section.settings.title_payment }}</h3>
      <p class="gf-feature__desc">{{ section.settings.desc_payment }}</p>
      <div class="gf-feature__badges">
        <span class="gf-badge">PayPal</span>
        <span class="gf-badge">Visa</span>
        <span class="gf-badge">Google Pay</span>
        <span class="gf-badge">Apple Pay</span>
      </div>
    </div>

  </div>
</section>

<style>
  #gf-features-{{ section.id }} {
    --gf-bg: {{ section.settings.bg_color }};
    --gf-accent: {{ section.settings.accent_color }};
    --gf-text: {{ section.settings.text_color }};
    --gf-title: {{ section.settings.title_color }};
    --gf-divider: {{ section.settings.divider_color }};
    --gf-icon-size: 56px;
    --gf-radius: 16px;
    --gf-transition: 0.3s ease;
  }

  .gf-features {
    background: var(--gf-bg);
    padding: 56px 24px;
    font-family: inherit;
  }

  .gf-features__inner {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  .gf-features__divider {
    width: 1px;
    height: 120px;
    background: var(--gf-divider);
    align-self: center;
    flex-shrink: 0;
    opacity: 0.4;
  }

  .gf-feature {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 36px;
    transition: transform var(--gf-transition);
    cursor: default;
  }

  .gf-feature:hover {
    transform: translateY(-4px);
  }

  .gf-feature__icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, color-mix(in srgb, var(--gf-accent) 12%, transparent), color-mix(in srgb, var(--gf-accent) 6%, transparent));
    border: 1.5px solid color-mix(in srgb, var(--gf-accent) 20%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: box-shadow var(--gf-transition), border-color var(--gf-transition);
  }

  .gf-feature:hover .gf-feature__icon-wrap {
    box-shadow: 0 8px 24px color-mix(in srgb, var(--gf-accent) 20%, transparent);
    border-color: color-mix(in srgb, var(--gf-accent) 40%, transparent);
  }

  .gf-feature__icon {
    width: var(--gf-icon-size);
    height: var(--gf-icon-size);
    color: var(--gf-accent);
    transition: color var(--gf-transition);
    padding: 8px;
    box-sizing: border-box;
  }

  .gf-feature__title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gf-title);
    margin: 0 0 12px;
  }

  .gf-feature__desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--gf-text);
    margin: 0 0 10px;
    max-width: 260px;
  }

  .gf-feature__link {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--gf-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--gf-accent) 35%, transparent);
    padding-bottom: 1px;
    transition: border-color var(--gf-transition), opacity var(--gf-transition);
  }

  .gf-feature__link:hover {
    border-color: var(--gf-accent);
    opacity: 0.85;
  }

  .gf-feature__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    margin-top: 6px;
  }

  .gf-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--gf-text);
    background: color-mix(in srgb, var(--gf-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--gf-accent) 18%, transparent);
    border-radius: 20px;
    padding: 3px 10px;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .gf-features__inner {
      flex-direction: column;
      align-items: center;
    }

    .gf-features__divider {
      width: 60px;
      height: 1px;
      margin: 0;
    }

    .gf-feature {
      padding: 28px 24px;
      width: 100%;
      max-width: 340px;
    }
  }
</style>

{% schema %}
{
  "name": "Feature Strips — Gala Ferron",
  "tag": "section",
  "class": "gf-features-section",
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento (íconos y enlaces)",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color títulos",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color texto",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color divisor",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Envío Gratis"
    },
    {
      "type": "text",
      "id": "title_shipping",
      "label": "Título",
      "default": "Envío Gratis"
    },
    {
      "type": "textarea",
      "id": "desc_shipping",
      "label": "Descripción",
      "default": "Ofrecemos envío gratuito en todos los pedidos."
    },
    {
      "type": "header",
      "content": "¿Necesitas Ayuda?"
    },
    {
      "type": "text",
      "id": "title_help",
      "label": "Título",
      "default": "¿Necesitas Ayuda?"
    },
    {
      "type": "textarea",
      "id": "desc_help",
      "label": "Descripción",
      "default": "Nuestro equipo de atención al cliente está a tu disposición:"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo de contacto",
      "default": "galaferronhelp@hotmail.com"
    },
    {
      "type": "header",
      "content": "Pago Seguro"
    },
    {
      "type": "text",
      "id": "title_payment",
      "label": "Título",
      "default": "Pago Seguro"
    },
    {
      "type": "textarea",
      "id": "desc_payment",
      "label": "Descripción",
      "default": "Paga de forma segura a través de PayPal, tarjeta de crédito, Google Pay o Apple Pay."
    }
  ],
  "presets": [
    {
      "name": "Feature Strips — Gala Ferron"
    }
  ]
}
{% endschema %}
